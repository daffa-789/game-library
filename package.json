{
  "name": "softgame-library",
  "version": "2.0.0",
  "description": "Katalog digital dua tab: game (dengan spesifikasi & impor Steam) dan software (tanpa spesifikasi). Dibangun dengan Electron + React (Vite).",
  "license": "MIT",
  "author": "Daffa",
  "private": true,
  "type": "module",
  "main": "electron/main.js",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "vite build",
    "start": "electron .",
    "verify": "electron scripts/verify.mjs",
    "smoke": "vite build && electron scripts/smoke.mjs",
    "dist": "vite build && electron-builder --win nsis --config electron-builder.yml"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "vite": "^6.0.7"
  }
}
